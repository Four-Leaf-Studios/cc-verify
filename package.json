{
  "name": "@four-leaf-studios/cc-verify",
  "version": "0.0.7",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build:lib": "npm run clean && vite build && npm run build:types",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "test": "vitest run",
    "clean": "rimraf dist dist-demo",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "rimraf": "^6.0.1",
    "rollup": "^4.50.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Four-Leaf-Studios/cc-verify"
  },
  "homepage": "https://github.com/four-leaf-studios/cc-verify#readme",
  "bugs": {
    "url": "https://github.com/four-leaf-studios/cc-verify/issues"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./brands": {
      "import": "./dist/brands.es.js",
      "require": "./dist/brands.cjs.js"
    },
    "./verify": {
      "import": "./dist/verify.es.js",
      "require": "./dist/verify.cjs.js"
    }
  },
  "typesVersions": {
    "*": {
      "brands": [
        "dist/types/brands.d.ts"
      ],
      "verify": [
        "dist/types/verify.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
